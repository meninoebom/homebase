{
  "name": "morning-ritual",
  "version": "0.2.0",
  "private": true,
  "description": "Homebase — personal morning writing surface. Pure HTML/JS at homebase/, runs in the browser via the File System Access API. Tauri shell removed April 15 2026.",
  "scripts": {
    "dev": "pnpm -C homebase dev",
    "build": "pnpm -C homebase build",
    "preview": "pnpm -C homebase preview",
