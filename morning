#!/usr/bin/env bash
# morning — walk today's morning ritual by iterating active slots.
#
# Usage:
#   morning                run the full sequence from slots.md
#   morning --only <slot>  run one slot from the sequence
#
# For ad-hoc slot invocation outside morning, use `ritual <slot>`
# (not yet implemented; will wrap this same shell with RITUAL_MODE=adhoc).
#
# Design constraints (plan §3, §15):
#   - morning is the center of gravity; adhoc use is an exception.
#   - the shell stays small. if it grows past ~60 lines, the slot
#     protocol is probably wrong, not the shell lacking features.
#   - halts on slot failure; surfacing breakage is better than masking it.

set -euo pipefail

RITUAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RITUAL_DATE="$(date +%Y-%m-%d)"
RITUAL_LOG="$RITUAL_ROOT/log/$RITUAL_DATE.md"
export RITUAL_DATE RITUAL_LOG
export RITUAL_MODE="${RITUAL_MODE:-morning}"

ONLY=""
if [[ "${1:-}" == "--only" ]]; then
  ONLY="${2:-}"
fi

# Ensure today's log exists with a human-readable date header so slots
# can append under their own "## <slot-name>" sections.
mkdir -p "$(dirname "$RITUAL_LOG")"
if [[ ! -f "$RITUAL_LOG" ]]; then
  printf '# %s\n\n' "$(date '+%A, %B %-d, %Y')" > "$RITUAL_LOG"
fi

# Greeting: name the day and quote yesterday's filename if it exists,
# so the morning starts by acknowledging that the logbook is alive (§11).
echo
echo "morning, brandon. $(date '+%A, %B %-d, %Y')."
yesterday_file="$RITUAL_ROOT/log/$(date -v-1d +%Y-%m-%d 2>/dev/null || date -d 'yesterday' +%Y-%m-%d).md"
if [[ -f "$yesterday_file" ]]; then
  echo "(yesterday: $(basename "$yesterday_file"))"
fi
echo

# Parse slots.md: take numbered list entries up to a "## Parked" section.
# Each line "1. gym — ..." contributes the first token after the number.
slots=$(awk '
  /^## Parked/ { exit }
  /^[0-9]+\. / { sub(/^[0-9]+\. +/, ""); print $1 }
' "$RITUAL_ROOT/slots.md")

start_ts=$(date +%s)
for slot in $slots; do
  if [[ -n "$ONLY" && "$slot" != "$ONLY" ]]; then
    continue
  fi
  slot_dir="$RITUAL_ROOT/$slot"
  run="$slot_dir/run.sh"
  if [[ ! -x "$run" ]]; then
    echo "── $slot ── (no executable run.sh at $run — skipping)"
    continue
  fi
  echo "── $slot ──"
  ( cd "$slot_dir" && "$run" )
  echo
done
end_ts=$(date +%s)
elapsed=$((end_ts - start_ts))
echo "done. ${elapsed}s."
